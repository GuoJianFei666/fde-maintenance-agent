DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Official Tool Calls example uses this model as of 2026-10-21.
DEEPSEEK_MODEL=deepseek-flash
MODEL_TIMEOUT_SECONDS=45
MAX_AGENT_ROUNDS=6
OPS_DATA_DIR=runtime
# inprocess calls tools in this process. mcp uses the MCP server.
TOOL_TRANSPORT=inprocess
MCP_TRANSPORT=stdio
MCP_URL=
# off leaves the text unchanged. rules does not call the model. llm uses the frozen few-shot prompt.
TEXT_NORMALISER=rules
# bm25 does not load an embedding model. dense, hybrid, and hybrid_rerank need an offline index.
RETRIEVER=bm25
RRF_K=60
RETRIEVAL_CANDIDATES=20
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RERANKER_MODEL=BAAI/bge-reranker-base
# sentence-transformers downloads weights. fake is the CI embedder and is not a semantic model.
EMBEDDER=sentence-transformers
